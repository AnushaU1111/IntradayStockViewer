{
  "name": "@isv/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API: fetches 15-minute Yahoo bars and returns per-day averages.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@isv/shared": "0.1.0",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
