# Copy to backend/.env for local runs. Every value below is the default.
# The app reads these from Phase 5 onward; spec section 4.6 explains each one.

HOST=0.0.0.0
PORT=3001

# Upstream (unofficial Yahoo Finance chart API)
YAHOO_BASE_URL=https://query1.finance.yahoo.com
YAHOO_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36

# Deadline and retries: one total budget covers every attempt and backoff
UPSTREAM_TOTAL_TIMEOUT_MS=8000
UPSTREAM_ATTEMPT_TIMEOUT_MS=3000
UPSTREAM_RETRIES=2

# Global upstream rate (Should tier) and fallback cooldown when Yahoo sends no usable Retry-After
UPSTREAM_MAX_RPS=2
UPSTREAM_COOLDOWN_SECONDS=30

# Cache TTLs: provider data and 422 results, then 404 results
CACHE_TTL_SECONDS=60
CACHE_NOT_FOUND_TTL_SECONDS=30

# Per-IP rate limit
RATE_LIMIT_PER_MINUTE=60

# false, or the exact IP or CIDR of the reverse proxy. Numbers are rejected (Fastify advisory GHSA-3m5p-2c4r-xxw2).
TRUST_PROXY=false

# Empty means same-origin only (no CORS). Comma-separated origins for split deployments.
CORS_ORIGINS=

# Test only: fixes the injected clock. The process refuses to start if set while NODE_ENV=production.
CLOCK_FIXED_AT=

LOG_LEVEL=info
